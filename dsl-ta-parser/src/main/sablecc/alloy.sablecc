Package org.openflexo.ta.dsl.parser;

Helpers

 ht = 0x0009;
 lf = 0x000a;
 ff = 0x000c;
 cr = 0x000d;
 sp = ' ';

 line_terminator = lf | cr | cr lf;

 upper_case = ['A' .. 'Z'] | [0x00c0 .. 0x00dd] | 0x20ac;
 lower_case = ['a' .. 'z'] | [0x00e0 .. 0x00fd] | 0x20ac;
 digit = ['0'..'9'];
 letter = upper_case | lower_case | '_' ;
 any = [0 .. 0xffff];
 not_hyphen = [any - '"' ];
 not_hyphen2 = [any - ''' ];

Tokens
 l_bkt = '[';
 r_bkt = ']';
 l_par = '(';
 r_par = ')';
 l_brace = '{';
 r_brace = '}';
 dot = '.';
 comma = ',';
 semi = ';';
 colon = ':';
 arrow = '->';
 range_restriction = ':>';
 domain_restriction = '<:';
 implies = '=>';
 intersection = '&';
 and = '&&';
 or = '||';
 vertical_bar = '|';
 number = digit+;
 equal = '=';
 dollar_sign = '$';
 percent_sign = '%';
 question_mark = '?';
 exclamation_point = '!';
 underscore = '_';
 double_quote_marks = '"';
 at = '@';
 minus = '-';
 dot_join = '.';
 relational_override = '++';
 plus = '+';
 cardinality = '#';
 transpose = '~';
 reflexive_transitive_closure = '*';
 transitive_closure = '^';
 bi_implication = '<=>';
 lt = '<' ;
 lte = '=<';
 gt = '>';
 gte = '>=';
 slash = '/';
 prime = ''';


// keywords

kw_abstract = 'abstract';
kw_after = 'after';
kw_all = 'all';
kw_always = 'always';
kw_and = 'and';
kw_as = 'as';
kw_assert = 'assert';
kw_before = 'before';
kw_but = 'but';
kw_check = 'check';
kw_disj = 'disj';
kw_else = 'else';
kw_enabled = 'enabled';
kw_event = 'event';
kw_eventually = 'eventually';
kw_exactly = 'exactly';
kw_extends = 'extends';
kw_fact = 'fact';
kw_for = 'for';
kw_fun = 'fun';
kw_historically = 'historically';
kw_iden = 'iden';
kw_iff = 'iff';
kw_implies = 'implies';
kw_in = 'in';
kw_int = 'Int';
kw_invariant = 'invariant';
kw_let = 'let';
kw_lone = 'lone';
kw_modifies = 'modifies';
kw_module = 'module';
kw_no = 'no';
kw_none = 'none';
kw_not = 'not';
kw_once = 'once';
kw_one = 'one';
kw_open = 'open';
kw_or = 'or';
kw_pred = 'pred';
kw_releases = 'releases';
kw_run = 'run';
kw_set = 'set';
kw_sig = 'sig';
kw_since = 'since';
kw_some = 'some';
kw_steps = 'steps';
kw_sum = 'sum';
kw_triggered = 'triggered';
kw_univ = 'univ';
kw_until = 'until';
kw_var = 'var';
kw_this = 'this';

// literals

 decimal_number = ['0' .. '9']+;
 precise_number = ['0' .. '9']+ '.' ['0' .. '9']+;
 scientific_notation_number =
 ['0' .. '9']+ '.' ['0' .. '9']+ 'e' ['0' .. '9']+
 | ['0' .. '9']+ '.' ['0' .. '9']+ 'e' '-' ['0' .. '9']+
 | ['0' .. '9']+ '.' ['0' .. '9']+ 'E' ['0' .. '9']+
 | ['0' .. '9']+ '.' ['0' .. '9']+ 'E' '-' ['0' .. '9']+;
 string_value = '"' (not_hyphen)* '"';
 chars_value = ''' (not_hyphen2)* ''';
 identifier = letter (letter | digit)*;
// blank = (' ' | 13 | 10)+;

 white_space = (sp | ht | ff | line_terminator)*;

Ignored Tokens
 white_space;

//used ChatGPT help to fix mistakes
Productions
 alloy_module = module_decl? import* paragraphs ;
 module_decl = kw_module qual_name module_decl_params? ;
 module_decl_params = {one} identifier | {more} identifier comma module_decl_params ;
 import = {import} kw_open qual_name import_names import_alias ;
 import_names = {some} comma qual_name import_names | {empty} ;
 import_alias = {alias} kw_as identifier | {empty} ;
 paragraphs = {more} paragraph paragraphs | {empty} ;
 paragraph = {sig} sig_decl | {fact} fact_decl | {pred} pred_decl | {fun} fun_decl | {assert} assert_decl | {cmd} cmd_decl ;
 sig_decl = kw_var? kw_abstract? mult? kw_sig sig_names sig_ext? l_brace field_decls r_brace block? ;
 sig_names = {one} identifier sig_names_tail   ;
 sig_names_tail = {more} comma identifier sig_names_tail | {empty} ;
 field_decls = {fields} field_decl field_decls_tail | {empty} ;
 field_decls_tail = {more} comma field_decl field_decls_tail | {empty} ;
 sig_ext = {extends} kw_extends qual_name | {in} kw_in qual_name sig_ext_names ;
 sig_ext_names = {more} plus qual_name sig_ext_names | {empty} ;
 mult = {lone} kw_lone | {some} kw_some | {one} kw_one ;
 field_decl = kw_var? decl ;
 decl = [first_disj]:decl_disj identifiers colon [second_disj]:decl_expr_disj expr ;
 decl_disj = {disj} [first]:kw_disj | {empty} ;
 decl_expr_disj = {disj} [second]:kw_disj | {empty} ;
 identifiers = identifier identifiers_tail ;
 identifiers_tail = {more} comma identifier identifiers_tail | {empty} ;
 fact_decl = kw_fact identifier? block ;
 pred_decl = kw_pred pred_qual_name identifier para_decls? block ;
 pred_qual_name = {qualified} qual_name dot | {empty} ;
 fun_decl = kw_fun fun_qual_name identifier para_decls? colon [return_type]:expr l_brace [body]:expr r_brace ;
 fun_qual_name = {qualified} qual_name dot | {empty} ;
 para_decls =  {some} decl para_decls_tail | {empty} ;
 para_decls_tail = {more} comma decl para_decls_tail | {empty} ;
 assert_decl = kw_assert identifier? block ;
 cmd_decl = cmd_name cmd_kind cmd_target scope? ;
 cmd_name = {named} identifier colon | {empty} ;
 cmd_kind = {run} kw_run | {check} kw_check ;
 cmd_target = {qual_name} qual_name | {block} block ;
 scope = kw_for number scope_but_opt | {types} kw_for typescopes ;
 scope_but_opt = {but} kw_but typescopes | {empty} ;
 typescopes = {one} typescope typescopes_tail ;
 typescopes_tail = {more} comma typescope typescopes_tail | {empty} ;
 typescope = kw_exactly? number qual_name ;
 expr = {const} const | {qual_name} qual_name | {at} at identifier | {this} kw_this | {un_op} un_op [unary]:expr | {bin_op} [left]:expr bin_op [right]:expr | {arrow_op} [left]:expr arrow_op [right]:expr | {call} [function]:expr call_args_opt | {compare} [left]:expr compare_prefix compare_op [right]:expr | {implies} [condition_expr]:expr implication_op [then_expr]:expr kw_else [else_expr]:expr | {let} kw_let let_decls block_or_bar | {quant} quant decls block_or_bar | {quant_block} l_brace decls block_or_bar r_brace | {prime_expr} [expression]:expr prime | {parenthesized} l_par [parenthesized]:expr r_par | {block} block ;
 decls = {one} decl decls_tail ;
 decls_tail = {more} comma decl decls_tail | {empty} ;
 let_decls = {one} let_decl let_decls_tail ;
 let_decls_tail = {more} comma let_decl let_decls_tail | {empty} ;
 implication_op = {implies} implies | {kw_implies} kw_implies ;
 compare_prefix = {not} exclamation_point | {not_kw} kw_not | {empty} ;
 call_args_opt = {call} l_par call_args r_par | {empty} ;
 call_args = {one} expr call_args_tail | {empty} ;
 call_args_tail = {more} comma expr call_args_tail | {empty} ;
 const = {minus} minus? number | {none} kw_none | {univ} kw_univ | {iden} kw_iden ;
 un_op =  {exclamation} exclamation_point | {not} kw_not | {no} kw_no | {mult} mult | {set} kw_set | {cardinality} cardinality | {transpose} transpose | {reflexive_transitive_closure} reflexive_transitive_closure | {transitive_closure} transitive_closure | {always} kw_always | {eventually} kw_eventually | {after} kw_after | {before} kw_before | {historically} kw_historically | {once} kw_once ;
 bin_op = {or} or | {kw_or} kw_or | {and} and | {kw_and} kw_and | {bi_implication} bi_implication | {kw_iff} kw_iff | {implies} implies | {kw_implies} kw_implies | {intersection} intersection | {plus} plus | {minus} minus | {relational_override} relational_override | {domain_restriction} domain_restriction | {range_restriction} range_restriction | {dot_join} dot_join | {kw_until} kw_until | {kw_releases} kw_releases | {kw_since} kw_since | {kw_triggered} kw_triggered ;
 arrow_op = [left]:arrow_mult_opt arrow [right]:arrow_mult_opt ;
 arrow_mult_opt = {mult} mult | {set} kw_set | {empty} ;
 compare_op = {in} kw_in | {equal} equal | {lt} lt | {gt} gt | {lte} lte | {gte} gte ;
 let_decl = identifier equal expr ;
 block = l_brace expr* r_brace ;
 block_or_bar = {block} block | {bar} bar expr ;
 bar = vertical_bar ;
 quant = {all} kw_all | {no} kw_no | {sum} kw_sum | {mult} mult ;
 qual_name = qual_name_prefixes identifier ;
 qual_name_prefixes = {this} kw_this slash qual_name_prefixes_tail | {empty} ;
 qual_name_prefixes_tail = {prefix} identifier slash qual_name_prefixes_tail | {empty} ;